{% extends "./unbranded.njk" %}
{% block content %}
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            <h1 class="govuk-heading-l">
                {% if pageCaption %}
                    <span class="govuk-caption-m">
                        {{ pageCaption }}
                    </span>
                {% endif %}
                {{ pageHeading }}
            </h1>
            <form method="post">
                {% block formContent %}{% endblock %}
                {{ govukButton({      text: buttonText or "Continue"     }) }}
            </form>
        </div>
    </div>
{% endblock %}