{% extends "layouts/form-page.njk" %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "macros/address.njk" import formatAddress %}
{% set customer = data.static.customers[0] %}
{% set name = customer.name %}
{% set nino = customer.nino %}
{% set dateOfBirth = customer.dateOfBirth %}
{% set address = data.address or customer.address %}
{% set showBackLink = true %}
{% set pageHeading = "Change customer address" %}
{% set reasonSomethingElse %}
{{ govukInput({
      id: "other-reason",
      name: "reasonForChangeOther",
      spellcheck: false,
      classes: "govuk-!-width-one-half",
      label: {
        text: "Reason"
      }
    }) }}
{% endset %}
{% block formContent %}
  {{ govukRadios({
      name: "reasonForChange",
      value:data.staticData.reasonForChange,
      fieldset: {
        legend: {
          text: "Reason for change"
        }
      },
      items: [
        {
          value: "recently-moved",
          text: "Recently moved"
        },
        {
          value: "temporary-accommodation",
          text: "Temporary accommodation"
        },
        {
          value: "homeless",
          text: "Homeless"
        },
        {
          divider: "or"
        },
        {
          value: "something-else",
          text: "Something else",
          conditional: {
            html: reasonSomethingElse
          }
        }
      ]
    }) }}
  {{ govukInput({
        label: {
          text: "Address line 1"
        },
        id: "address-line-1",
        name: "line1",
        value: address.line1,
        autocomplete: "address-line1"
      }) }}
  {{ govukInput({
        label: {
          text: "Address line 2 (optional)"
        },
        id: "address-line-2",
        name: "line2",
         value: address.line2,
        autocomplete: "address-line2"
      }) }}
  {{ govukInput({
        label: {
          text: "Town or city"
        },
        classes: "govuk-!-width-two-thirds",
        id: "address-town",
        name: "city",
        value: address.city,
        autocomplete: "address-level2"
      }) }}
  {{ govukInput({
        label: {
          text: "County (optional)"
        },
        classes: "govuk-!-width-two-thirds",
        id: "address-county",
        name: "county",
          value: address.county
      }) }}
  {{ govukInput({
        label: {
          text: "Postcode"
        },
        classes: "govuk-input--width-10",
        id: "address-postcode",
        name: "postcode",
        value: address.postcode,
        autocomplete: "postal-code"
      }) }}
{% endblock %}