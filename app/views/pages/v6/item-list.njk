{% extends "layouts/unbranded.html" %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/select/macro.njk" import govukSelect %}

{% from "macros/back-link.njk" import backLink %}

{% block pageTitle %}
    GOV.UK page template –
    {{ serviceName }}
    – GOV.UK Prototype Kit
{% endblock %}

{% block backLink %}
    {{ backLink("add-an-item") }}
{% endblock %}

{% set otherReasonHtml %}
{{ govukInput({
  id: "other-reason",
  name: "otherReason",
  spellcheck: false,
  classes: "govuk-!-width-one-third",
  label: {
    text: "Reason"
  }
}) }}
{% endset -%}

{% set fasterPaymentReasonHtml %}
{{ govukInput({
  id: "faster-payment-reason",
  name: "fasterPaymentReason",
  spellcheck: false,
  classes: "govuk-!-width-one-third",
  label: {
    text: "Reason"
  }
}) }}
{% endset -%}

{% block content %}

    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            <span class="govuk-caption-l">{{data['supplier-name']}}</span>
            <h1 class="govuk-heading-l">Item list</h1>
            <form action="/submit-item-list" method="post">
                <p>Multiple items can be bought from a single supplier.</p>
                <p>If buying items from more than one supplier, you can
                    <strong>add another supplier</strong>
                    to the claim after completing this section.</p>

                {{ govukSummaryList({
                        card: {
                            title: {
                            text: "Shoes"
                            },
                            actions: {
                                items: [
                                {
                                    href: "#",
                                    text: "Change"
                                }
                                ]
                            }
                        },
                        rows: [
                            {
                            key: {
                                text: "Category"
                            },
                            value: {
                                text: "Something else"
                            }
                            },
                            {
                             key: {
                                text: "Cost"
                            },
                            value: {
                                text: "£33.50"
                            }
                            }
                        ]
                        }) 
                        }}
                {{ govukButton({
                            text: "Add an item",
                            href: 'add-an-item',
                            classes: "govuk-button--secondary"
                            }) }}

                <hr class="govuk-section-break govuk-section-break--visible">
                <br/>

                {{ govukInput({
                    id: "cost",
                    name: "cost",
                    label: {
                        text: "Additional costs (optional)"
                    },
                    hint:{
                        text:'For example, service or delivery charges'
                    },
                    prefix: {
                        text: "£"
                    },
                    classes: "govuk-input--width-5",
                    spellcheck: false
                    }) }}

                {{ govukTextarea({
                    name: "moreInformation",
                    id: "moreInformation",
                    label: {
                        text: "Evidence for additional costs (optional)",
                        classes: "govuk-fieldset__legend",
                        isPageHeading: false
                    }

                            }) 
                            }}

                <p>
                    <strong>Supplier total
                    </strong>
                    &nbsp; &nbsp; &nbsp; £33.50</p>
                <hr class="govuk-section-break govuk-section-break--visible">
                <br/>

                {{ govukRadios({
                    name: "payment-method",
                    fieldset: {
                        legend: {
                        text: "Payment method",
                        classes: "govuk-fieldset__legend--m"
                        }
                    },
                    items: [
                        { value: "APPROVAL_TO_BUY", text: "Approval to Buy (A2B)" },
                        { value: "CENTRAL_PAYMENT_SYSTEM", text: "Central Payment System (CPS)", 
                        conditional: { 
                            html: fasterPaymentReasonHtml
                        }
                        }
                        ]
                    }) }}
                {{ govukButton({
                        text: "Continue",
                        type: "submit"
                        }) }}

            </form>
        </div>
    </div>
{% endblock %}